# admin-web → admin-api base URL.
#
# Local development: matches apps/admin-api/wrangler.toml [dev].port.
# Production: set to the deployed admin-api Worker, e.g.
#   https://citizenry-admin-api.<workers-subdomain>.workers.dev
#
# SvelteKit treats PUBLIC_* vars as client-bundled at build time, so a
# fork has to set the right value before `pnpm build`.
PUBLIC_ADMIN_API_BASE_URL=http://localhost:13001
