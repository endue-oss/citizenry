---
// Scalar API Reference, full-bleed inside the Starlight site.
//
// Three SSG routes are generated — /api/identity/, /api/vault/,
// /api/mail/ — each loading exactly one OpenAPI YAML. The Scalar
// standalone bundle and the YAMLs sit at `public/` root, copied by
// sync-content.mjs. Configuration mirrors what the prior static
// shell already shipped (modal Client + inline Test Request both
// enabled, Powered-by-Scalar hidden via customCss).
//
// The page is full-bleed (no Starlight chrome) but still mounts the
// citizenry.id-style Header so the Scalar pages share the same
// nav-pill as the marketing site. handbook.css carries the raw
// design tokens (--fg, --accent, --space-*, …) the Header.scss
// expects.

import Header from '../../citizenry-id/Header.svelte'
import '../../styles/handbook.css'

export function getStaticPaths() {
  return [
    { params: { slug: 'identity' }, props: { title: 'Identity', file: 'identity-api.yaml' } },
    { params: { slug: 'vault' },    props: { title: 'Vault',    file: 'vault-api.yaml' } },
    { params: { slug: 'mail' },     props: { title: 'Mail',     file: 'mail-api.yaml' } },
  ]
}

const { title, file } = Astro.props
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Citizenry API · {title}</title>
    <meta
      name="description"
      content={`OpenAPI reference for the Endue Citizenry ${title} service.`}
    />
    <link rel="icon" href="data:," />
    <!-- Match citizenry.id: same Inter + JetBrains Mono web fonts so
         the Header.scss nav-pill metrics line up with the marketing
         site (otherwise the system mono fallback skews the trigger
         button's baseline and the hover background drifts). -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />
    <!-- is:global: the Header lives in a hydrated Svelte island, so its
         `.site-header` markup never receives Astro's scope class — scoped
         selectors would silently miss it. These rules target global / island
         elements only, so unscoping the block is correct. -->
    <style is:global>
      html, body { margin: 0; padding: 0; }
      /* Inherit the citizenry.id sans (Inter) on the document root so the
       * Header wordmark renders in-brand. Without this the <a class="brand">
       * falls back to the UA serif (Scalar scopes its own font to
       * `.scalar-app`, so it never reached the Header). */
      body {
        background: var(--bg, #09090b);
        color: var(--fg, #fafafa);
        font-family: var(--sans);
      }

      /* Header lives in its own full-bleed document here (no Starlight
       * `.page` wrapper), so the global `a { text-decoration: none }` reset
       * the marketing site relies on is absent — strip the UA underline off
       * the brand + fork links directly. Scoped to the Header so Scalar's
       * own link styling is untouched. */
      .site-header a,
      .site-header a:hover { text-decoration: none; }

      /* Tell Scalar a custom header of --header-h overlays the top edge of
       * its app. Scalar then offsets its sticky sidebar + search and its
       * content below our Header (top: --header-h, sidebar height:
       * 100dvh - --header-h) instead of pinning them to viewport top where
       * they collided with the logo on scroll. */
      :root { --scalar-custom-header-height: var(--header-h, 56px); }

      /* Make the (sticky) Header opaque. The shared Header.scss keeps the
       * bar transparent for the marketing hero; here there is no hero, and
       * Scalar content scrolls up underneath the sticky bar, so a
       * transparent strip lets that content bleed through and overlap the
       * logo. A solid fill blocks it. No backdrop-filter — a filter on the
       * Header would clip the nav dropdown's own backdrop blur. */
      .site-header { background: var(--bg, #09090b); }

      /* App fills the viewport below the sticky Header. */
      #app { min-height: calc(100vh - var(--header-h, 56px)); }

      /* Full-bleed API layout: Scalar spans the whole width, so drop the
       * marketing site's 1120px max-width on the Header inner and let it
       * span full width too. Its existing 24px (--space-4) side padding
       * then lines the logo + Human/Agent CTA up with Scalar's own 24px
       * content gutter, instead of hugging the edges (or floating in a
       * narrow centered column adrift from the full-bleed content). */
      .site-header .inner { max-width: none; }

      /* Tame stray horizontal scroll. Scalar already wraps its own wide
       * content (tables, code samples) in internal overflow-x:auto boxes,
       * and its search overlay paints a 100vw fixed backdrop — none of
       * which the page itself needs to scroll sideways for. `clip` (not
       * `hidden`) doesn't create a scroll container, so the sticky Header
       * and Scalar's sticky sidebar still pin correctly. */
      html { overflow-x: clip; }
    </style>
  </head>
  <body>
    <Header client:load onEnroll={() => {}} />
    <div id="app"></div>
    <script is:inline src="/scalar.standalone.js"></script>
    <script type="module" is:inline define:vars={{ file, title }}>
      Scalar.createApiReference('#app', {
        theme: 'deepSpace',
        layout: 'modern',
        darkMode: true,
        hideClientButton: false,
        hideTestRequestButton: false,
        hideDownloadButton: true,
        sources: [{ url: `/${file}`, title, slug: title.toLowerCase(), default: true }],
        metaData: { title: `Citizenry API · ${title}` },
        // Selectors track Scalar's internal markup and may need a touch-up
        // when @scalar/api-reference is bumped. The `a[href*="scalar.com"]`
        // rule is the safety net — if the brand link survives, this catches it.
        customCss: `
          .scalar-api-reference [data-testid="scalar-brand"],
          .scalar-api-reference .references-footer,
          .scalar-api-reference .scalar-api-client__footer,
          .scalar-api-reference a[href*="scalar.com"] { display: none !important; }
        `,
      })
    </script>
  </body>
</html>
