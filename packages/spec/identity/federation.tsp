import "@typespec/http";
import "@typespec/openapi";
import "../common/main.tsp";

using TypeSpec.Http;
using TypeSpec.OpenAPI;
using Citizenry.Common;

// @status draft — implements RFC-0001 (federation peers).
namespace Citizenry.Identity;

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Federation enums / scalars
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

/**
 * federation_peer.state — RFC-0001 §"State machine".
 *
 * Transitions:
 *   invited   → pending | revoked
 *   pending   → trusted | revoked
 *   trusted   → suspended | revoked
 *   suspended → trusted   | revoked
 *
 * @status confirmed
 */
enum FederationPeerState {
  invited,
  pending,
  trusted,
  suspended,
  revoked,
}

/**
 * Handshake JWS `purpose` claim.
 *
 *   federation.invite        — A → B initial handshake.
 *   federation.invite.ack    — B → A reply (confirmation or rejection metadata).
 *   federation.confirm       — A → B confirmation echo (enters trusted).
 *   federation.confirm.ack   — B → A final ack.
 *   federation.revoke        — terminate the relationship, from either side.
 *   federation.suspend       — pause.
 *   federation.resume        — resume.
 *
 * @status confirmed
 */
enum FederationPurpose {
  invite: "federation.invite",
  invite_ack: "federation.invite.ack",
  confirm: "federation.confirm",
  confirm_ack: "federation.confirm.ack",
  revoke: "federation.revoke",
  suspend: "federation.suspend",
  resume: "federation.resume",
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Wire models
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

/**
 * Response of the public `/.well-known/citizenry-peer` endpoint.
 *
 * @status confirmed
 */
model PeerDiscoveryGetResponse {
  /** Federation protocol version (currently 1). */
  protocol_version: int32;

  /** Self issuer URL (e.g. "https://citizenry.id"). */
  issuer: string;

  /** Stable self-id — unaffected by JWKS rotation. */
  instance_id: instanceId;

  /** Display name. Operator-configured. */
  display_name?: string;

  /** JWKS endpoint used to verify federation JWS. */
  federation_jwks_url: string;

  /** Federation handshake endpoint. */
  federation_handshake_url: string;

  /** Policy hints (advisory). */
  policies?: PeerPolicies;
}

/**
 * @status confirmed
 */
model PeerPolicies {
  /** When true, an inbound invite is auto-promoted all the way to trusted. */
  auto_accept?: boolean = false;

  /** Maximum number of peers this instance will accept (enforced server-side). */
  max_peers?: int32 = 256;
}

/**
 * Federation handshake JWS body (the payload of the compact JWS).
 *
 * The credential is **the body itself as a compact JWS**, not an
 * `Authorization` header. Content-Type: `application/jws`.
 *
 * @status confirmed
 */
model FederationHandshakePayload {
  /** Sender instance issuer URL. */
  from_issuer: string;

  /** Sender instance instance_id. */
  from_instance_id: instanceId;

  /** Receiver instance issuer URL (mismatch → 401). */
  to_issuer: string;

  /** Message intent — used by the router for dispatch. */
  purpose: FederationPurpose;

  /** Display name (the response includes it; the peer mirrors it locally). */
  display_name?: string;

  /** 32-byte base64url nonce generated by the sender on invite. */
  nonce: base64url;

  /** On confirm / ack: echoes the original invite's `nonce`. */
  nonce_echo?: base64url;

  /** Unix epoch seconds. */
  iat: unixTimestamp;

  /** No greater than `iat + 600`. */
  exp: unixTimestamp;

  /** Free-form metadata (policy changes, display-name updates, …). */
  metadata?: Record<unknown>;
}

/**
 * Handshake endpoint response.
 *
 * @status confirmed
 */
model FederationHandshakeResponse {
  /** Resulting state — the receiver's `federation_peer.state`. */
  state: FederationPeerState;

  /** Responder's instance_id (the requester mirrors it locally). */
  instance_id: instanceId;

  /** Responder issuer. */
  issuer: string;

  /** ack JWS the responder included (compact). May be empty when a
   *  follow-up round is required to verify. */
  ack_jws?: string;
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Admin models — peer CRUD
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

/**
 * Peer row as seen by an admin.
 *
 * @status confirmed
 */
model FederationPeerGetResponse {
  id: federationPeerId;
  issuer: string;
  instance_id?: instanceId;
  display_name?: string;
  state: FederationPeerState;
  protocol_version: int32;

  /** Federated tenant materialized at the moment of becoming trusted.
   *  null = not yet created. */
  tenant_id?: tenantId;

  /** Original discovery response, cached. */
  peer_metadata?: Record<unknown>;

  jwks_cached_at?: iso8601;
  trusted_at?: iso8601;
  suspended_at?: iso8601;
  revoked_at?: iso8601;
  created_at: iso8601;
  updated_at: iso8601;
}

/**
 * Admin POST body — add a peer (initiates an outbound handshake).
 *
 * @status confirmed
 */
model FederationPeerCreateRequest {
  /** Issuer URL of the peer to add (e.g. "https://bob.citizenry.example"). */
  @minLength(8)
  @maxLength(255)
  issuer_url: string;

  /** Display name — falls back to the discovery response's display_name
   *  when unset. */
  @maxLength(255)
  display_name?: string;
}

/**
 * Admin POST body — state transition (suspend / resume).
 *
 * `revoke` is a separate DELETE route.
 *
 * @status confirmed
 */
model FederationPeerTransitionRequest {
  /** Only suspend → trusted and trusted → suspended are allowed. */
  target_state: FederationPeerState;

  /** Operator note (audit log payload). */
  @maxLength(500)
  reason?: string;
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Routes
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

/**
 * Public peer discovery — JSON, no auth, cacheable (max-age=300).
 *
 * @status confirmed
 */
@tag("Federation")
@route("/.well-known/citizenry-peer")
@useAuth(NoAuth)
interface FederationPeerDiscovery {
  @summary("Public peer discovery document")
  @operationId("federation-peer-discovery")
  @get read(): PeerDiscoveryGetResponse | InternalError;
}

/**
 * Peer-to-peer handshake endpoint.
 *
 * The request body is a **compact JWS** (text/plain accepted; preferred
 * `application/jws`). The payload is `FederationHandshakePayload`.
 *
 * Authentication is the JWS signature itself — no `Authorization` header.
 *
 * Possible errors:
 *   401 (ERR-P01-FED-1001 JWS verify failed,
 *        ERR-P01-FED-1002 from_issuer mismatch,
 *        ERR-P01-FED-1003 replay)
 *   422 (ERR-P01-FED-2001 invalid issuer URL)
 *   409 (ERR-P01-FED-3003 state transition not allowed)
 *   502 (ERR-P01-FED-4001/4002 discovery / JWKS fetch failed)
 *
 * @status confirmed
 */
@tag("Federation")
@route("/federation/handshake")
@useAuth(NoAuth)
interface FederationHandshake {
  @summary("Federation handshake — receive an invite / confirm / revoke")
  @operationId("federation-handshake")
  @post handle(
    @header("content-type") contentType: "application/jws" | "application/jws+json",
    @body jws: string,
  ):
    | FederationHandshakeResponse
    | BadRequestError
    | UnauthorizedError
    | ConflictError
    | UnprocessableError
    | BadGatewayError
    | InternalError;
}

/**
 * Admin federation peer CRUD — authenticated with `X-Service-Key`.
 *
 * @status confirmed
 */
@tag("Federation")
@route("/v1/admin/federation/peers")
@useAuth(ServiceKeyAuth)
interface AdminFederationPeers {
  /**
   * Add a peer — initiates an outbound handshake.
   *
   * 1) Fetch the peer's `.well-known/citizenry-peer` and JWKS.
   * 2) INSERT a `federation_peer` row with state='invited'.
   * 3) POST a signed invite to the peer's `/federation/handshake`.
   * 4) Update state based on the response (pending | trusted | revoked).
   * 5) On trusted, the federated tenant is materialized.
   *
   * The response is the row state immediately after INSERT — async
   * transitions are observable via GET.
   *
   * Possible errors: 401, 422 (2001), 409 (3002), 502 (4001/4002/4003), 500.
   */
  @summary("Add a federation peer (initiates outbound handshake)")
  @operationId("admin-federation-peer-create")
  @post create(@body input: FederationPeerCreateRequest):
    | FederationPeerGetResponse
    | UnauthorizedError
    | UnprocessableError
    | ConflictError
    | BadGatewayError
    | InternalError;

  /**
   * Possible errors: 401, 500.
   */
  @summary("List federation peers (paginated)")
  @operationId("admin-federation-peer-list")
  @get list(
    @query state?: FederationPeerState,
    ...PaginationParams,
  ): PaginatedList<FederationPeerGetResponse> | UnauthorizedError | InternalError;

  /**
   * Possible errors: 401, 404 (3001), 500.
   */
  @summary("Read federation peer")
  @operationId("admin-federation-peer-read")
  @get read(@path id: federationPeerId):
    | FederationPeerGetResponse
    | UnauthorizedError
    | NotFoundError
    | InternalError;

  /**
   * trusted ⇄ suspended transition.
   * Any other transition attempt returns 409 (ERR-P01-FED-3003).
   *
   * Possible errors: 401, 404 (3001), 409 (3003), 502 (4003), 500.
   */
  @summary("Transition federation peer state")
  @operationId("admin-federation-peer-transition")
  @route("/{id}/transition")
  @post transition(@path id: federationPeerId, @body input: FederationPeerTransitionRequest):
    | FederationPeerGetResponse
    | UnauthorizedError
    | NotFoundError
    | ConflictError
    | BadGatewayError
    | InternalError;

  /**
   * Permanently revoke a peer.
   * - state='revoked', tenant.status='archived'.
   * - POST a `federation.revoke` JWS to the peer (best-effort; local
   *   termination proceeds regardless).
   * - Memberships are retained as a historical record.
   * - Re-joining the same issuer creates a new fdp_* row.
   *
   * Possible errors: 401, 404 (3001), 500.
   */
  @summary("Revoke a federation peer (permanent)")
  @operationId("admin-federation-peer-revoke")
  @delete revoke(@path id: federationPeerId):
    | {
        @statusCode statusCode: 204;
      }
    | UnauthorizedError
    | NotFoundError
    | InternalError;

  /**
   * Refresh cached JWKS immediately — used when the peer rotates keys
   * and the operator wants to force a fetch.
   *
   * Possible errors: 401, 404 (3001), 502 (4002), 500.
   */
  @summary("Refresh cached JWKS for a peer")
  @operationId("admin-federation-peer-refresh-jwks")
  @route("/{id}/jwks-refresh")
  @post refreshJwks(@path id: federationPeerId):
    | FederationPeerGetResponse
    | UnauthorizedError
    | NotFoundError
    | BadGatewayError
    | InternalError;
}
