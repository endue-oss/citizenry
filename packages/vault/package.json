{
  "name": "@citizenry/vault",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./admin": "./src/router/admin.ts",
    "./schema": "./src/db/schema.ts",
    "./service": "./src/service/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply citizenry-vault --local",
    "db:migrate": "wrangler d1 migrations apply citizenry-vault --remote"
  },
  "dependencies": {
    "@citizenry/identity": "workspace:*",
    "@citizenry/spec": "workspace:*",
    "drizzle-orm": "^0.36.4",
    "hono": "^4.6.10",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "drizzle-kit": "^0.28.1",
    "typescript": "^5.6.3",
    "wrangler": "^3.86.0"
  }
}
